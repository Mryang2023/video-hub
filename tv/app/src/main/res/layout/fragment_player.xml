<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:show_buffering="never"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- 播放失败面板 -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF6961"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="26dp"
                android:text="@string/pp_retry"
                android:textColor="@color/chip_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSwitchSrc"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="26dp"
                android:text="@string/pp_switch_src"
                android:textColor="@color/chip_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnErrBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="26dp"
                android:text="@string/back"
                android:textColor="@color/chip_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- OSD：5 秒无操作自动隐藏 -->
    <FrameLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:id="@+id/ptop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/back"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/chip_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pbot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFCFCFD4"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#FF8E8E93"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/pDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFCFCFD4"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/pbarWrap"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/pTrack"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bar_track">

                    <View
                        android:id="@+id/pFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bar_fill" />
                </FrameLayout>
            </FrameLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPrev"
                        style="@style/PpBtn"
                        android:text="@string/pp_prev" />

                    <TextView
                        android:id="@+id/btnPP"
                        style="@style/PpBtn"
                        android:text="@string/pp_pause" />

                    <TextView
                        android:id="@+id/btnNext"
                        style="@style/PpBtn"
                        android:text="@string/pp_next" />

                    <TextView
                        android:id="@+id/btnEps"
                        style="@style/PpBtn"
                        android:text="@string/pp_eps" />

                    <TextView
                        android:id="@+id/btnRate"
                        style="@style/PpBtn"
                        android:text="@string/pp_rate" />

                    <TextView
                        android:id="@+id/btnFav"
                        style="@style/PpBtn"
                        android:layout_marginEnd="0dp"
                        android:text="@string/fav_add" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- 播放内选集面板：不退出播放器直接挑集/换分组 -->
    <FrameLayout
        android:id="@+id/epPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20A0A12"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_ep_panel"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/epTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按返回键关闭"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/epTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/epGrid"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
