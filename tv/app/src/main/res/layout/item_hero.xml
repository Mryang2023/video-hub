<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 全幅 Hero：通栏大图 + 左下角大标题/简介/白色播放胶囊 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:layout_marginTop="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/fg_hero_focus">

    <ImageView
        android:id="@+id/heroImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/hero_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#FFD8D8DE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/heroPlay"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_play"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
